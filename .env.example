REDIS_URL=redis://redis:6379
CACHE_TTL_ANALYSIS=86400
CACHE_TTL_EXPORT=3600
CACHE_TTL_JOB=7200
PRECOMPUTE_WORKERS=2
DATA_DIR=/app/data

# JWT Auth — obrigatorio
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=720
FRONTEND_ORIGIN=http://localhost:3000
SECURE_COOKIES=false

# Multi-user override (opcional — defaults hardcoded em config/settings.py)
# Formato: user1:argon2hash|||user2:argon2hash
# APP_USERS=admin:$argon2id$...|||thiago:$argon2id$...

# --- feat/grade ---
# Postgres (container postgres — porta interna 5432, externa 5433)
POSTGRES_USER=dashgrade
POSTGRES_PASSWORD=dashgrade
POSTGRES_DB=dash_grade
DATABASE_URL=postgresql+asyncpg://dashgrade:dashgrade@postgres:5432/dash_grade

# Schedulers (scrapers + favoritos). So o container `workers` deve ter RUN_SCHEDULERS=true
RUN_SCHEDULERS=false
SCRAPER_REFRESH_MIN=10
FAVORITES_SYNC_MIN=10
SCRAPER_SCHEDULER_LOCK_KEY=dashtg:scraper:scheduler:lock
FAVORITES_SYNC_LOCK_KEY=dashtg:favorites:sync:lock
SCRAPER_MAX_WORKERS=3
